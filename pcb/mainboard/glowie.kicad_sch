	)
	(text_box "USB/CHG -- Used to detect plugged USB and charging state with a single input\n\nWith CHRG_EN low, CHRG is HI, so an input Low means USB not connected, and input High means USB connected.\nAfter enabling charger, enable input PU on MCU. Then, Low means it is charging (pulled by CHRG).\nAfter it goes High, disable PU and disable charger to detect USB connection status"
		(exclude_from_sim no)
		(at 133.35 163.83 0)
		(size 33.02 23.1679)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "52d62393-bd17-4df2-84f1-3fc6c3249a82")
	)
	(text_box "CHG_EN/DONE ----\n\nOutput HIGH to enable, LOW to disable.\n\nUse as input with PU to detect CHRG_DONE. Then input will go LOW when pulled by CHRG_DONE.\nThis will also disable charger.\n(Will the MCU have time to detect the LOW before charger gets disabled and CHRG_DONE goes HI again?)"
		(exclude_from_sim no)
		(at 22.86 124.46 0)
		(size 36.83 19.8965)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "ef085ba0-4670-408f-86f5-c4ddf6a2494e")
	)
